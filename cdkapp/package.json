{
  "name": "cdk",
  "version": "0.1.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "22.1.0",
    "@types/prettier": "2.7.3",
    "aws-cdk": "^2.1135.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.5.1",
    "source-map-support": "^0.5.21"
  },
  "overrides": {
    "fast-uri": ">=3.1.4",
    "js-yaml": ">=4.1.0",
    "@babel/core": ">=7.29.1",
    "brace-expansion": ">=5.0.9"
  },
  "overridesJustification": {
    "fast-uri": {
      "cves": [
        "CVE-2026-13676",
        "CVE-2026-16221"
      ],
      "reason": "Host confusion vulnerabilities in fast-uri <= 3.1.3",
      "removeWhen": "aws-cdk-lib bundles fast-uri >= 3.1.4"
    },
    "js-yaml": {
      "cves": [
        "GHSA-h67p-54hq-rp68",
        "GHSA-52cp-r559-cp3m"
      ],
      "reason": "Quadratic DoS in merge key handling",
      "removeWhen": "Parent dependency ships with js-yaml >= 4.1.0"
    },
    "@babel/core": {
      "cves": [
        "GHSA-4x5r-pxfx-6jf8"
      ],
      "reason": "Arbitrary file read via sourceMappingURL comment",
      "removeWhen": "jest/ts-jest ships with @babel/core >= 7.29.1"
    },
    "brace-expansion": {
      "cves": [
        "GHSA-rgw5-rvv9-x895",
        "GHSA-3jxr-9vmj-r5cp",
        "GHSA-mh99-v99m-4gvg"
      ],
      "reason": "Multiple DoS vulnerabilities. Bundled in aws-cdk-lib — override may not reach bundled copy.",
      "removeWhen": "aws-cdk-lib ships with brace-expansion >= 5.0.9 (tracked: aws/aws-cdk#38496)"
    }
  }
}
